# ====================================================================
# Git 忽略文件配置 (.gitignore)
# 涵盖 Vue 3 前端工程与 Node.js Express 后端服务
# ====================================================================

# 1. 依赖目录 (前端与后端)
node_modules/
**/node_modules/
server/node_modules/

# 2. 打包与构建输出
dist/
dist-ssr/
*.local

# 3. 环境变量与敏感凭据
.env
.env.local
.env.*.local
server/.env
server/.env.local

# 4. 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. 编辑器与操作系统缓存
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
